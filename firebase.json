{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8180
    },
    "ui": {
      "enabled": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "accounts",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".env*",
        ".secret.local",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix functions run check"
      ]
    }
  ]
}
